{
  "name": "zkx-build",
  "private": true,
  "scripts": {
    "build": "python tools/build.py",
    "start": "electron app",
    "dist:win": "npm install --prefix app --omit=dev && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pandazkx.zkx",
    "productName": "ZKX",
    "copyright": "PandaZkx",
    "directories": {
      "app": "app",
      "output": "dist"
    },
    "electronVersion": "45.2.1",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZKX",
      "uninstallDisplayName": "ZKX",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "artifactName": "ZKX-Setup-${version}.exe",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PandaZkx",
        "repo": "ZKX"
      }
    ],
    "asar": false,
    "files": [
      "**/*",
      "!node_modules/tesseract.js-core/*relaxedsimd*",
      "!node_modules/tesseract.js-core/tesseract-core.*",
      "!node_modules/tesseract.js-core/tesseract-core-simd.*",
      "!node_modules/@tesseract.js-data/fra/4.0.0_best_int/**"
    ]
  }
}
